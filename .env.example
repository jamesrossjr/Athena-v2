# Database
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Supabase
NUXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
NUXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# App Configuration
NUXT_APP_VERSION="0.1.0"
NUXT_APP_BUILD_ID="dev"
NUXT_PUBLIC_API_BASE="/api"

# Universal AI Assistant Configuration
# Choose one or more AI providers - the assistant will use the first available

# OpenAI (GPT models) - Recommended for general use
NUXT_OPENAI_API_KEY="your_openai_api_key_here"

# Anthropic Claude - Good for detailed analysis
NUXT_CLAUDE_API_KEY="your_claude_api_key_here"

# Google Gemini - Free tier available
NUXT_GEMINI_API_KEY="your_gemini_api_key_here"

# Set the default AI provider (openai, claude, or gemini)
NUXT_AI_PROVIDER="openai"

# Alternative: Use a single unified AI API key (if you have a service that provides multiple models)
# NUXT_AI_API_KEY="your_unified_ai_api_key"