// Icons (simple SVG components)
const SearchIcon = {
  template: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>`
}

const CommandIcon = {
  template: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3"/></svg>`
}

const AIIcon = {
  template: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`
}

// Props and emits
const emit = defineEmits(['execute', 'close', 'execute-action'])

// State
const isOpen = ref(false)
const query = ref('')
const debouncedQuery = ref('')
const selectedIndex = ref(0)
const isLoading = ref(false)
const inputRef = ref(null)
const panelRef = ref(null)
const searchTime = ref(0)

// Enhanced Features State
const currentMode = ref('search') // search, ai, commands
const detectedIntent = ref('search') // search, command, ai, file, navigation
const showModeToggle = ref(false) // Show mode toggle only when needed
const isProcessingAI = ref(false)
const aiConversation = ref([])

// Voice Commands State
const isVoiceListening = ref(false)
const voiceSupported = ref(false)

// Predictive Features
const predictiveSuggestions = ref([])
const userPatterns = ref({})

// Settings State
const showSettings = ref(false)
const settings = ref({
  theme: 'light',
  aiProvider: 'openai',
  searchSuggestions: true,
  voiceCommands: true,
  analytics: true,
  // API Keys
  openaiApiKey: '',
  claudeApiKey: '',
  geminiApiKey: '',
  // Ollama Configuration
  ollamaBaseUrl: 'http://localhost:11434',
  ollamaModel: 'llama2'
})

// Temporary settings for pending changes
const tempSettings = ref({
  theme: 'light',
  aiProvider: 'openai',
  searchSuggestions: true,
  voiceCommands: true,
  analytics: true,
  openaiApiKey: '',
  claudeApiKey: '',
  geminiApiKey: '',
  ollamaBaseUrl: 'http://localhost:11434',
  ollamaModel: 'llama2'
})

const showApiKeys = ref({
  openai: false,
  claude: false,
  gemini: false
})

const connectionStatus = ref(null)
const settingsChanged = ref(false)

const expandedSections = ref({
  ai: true, // Start with AI section open
  interface: false
})

// Multi-Intent Recognition
const detectedIntents = ref([]) // Multiple intents for complex queries
const intentConfidence = ref({}) // Confidence scores for each intent
const contextualSuggestions = ref([])

// Progressive Learning
const learningData = ref({
  userPreferences: {},
  commandHistory: [],
  searchPatterns: {},
  intentAccuracy: 0
})

// Zero-State Dashboard Data
const dashboardData = ref({
  quickActions: [],
  recentActivity: [],
  contextualSuggestions: [],
  behavioralPatterns: {},
  temporalContext: {
    timeOfDay: '',
    dayOfWeek: '',
    workingHours: true,
    seasonalContext: ''
  },
  activityScore: 0,
  lastRefresh: null
})

// Mode Configuration
const modes = ref([
  { key: 'search', label: 'Search', icon: '🔍' },
  { key: 'ai', label: 'AI Assistant', icon: '🤖' },
  { key: 'commands', label: 'Commands', icon: '⚡' }
])

// Command Intelligence
const {
  learnFromAction,
  loadPreferences,
  savePreferences
} = useCommandIntelligence()

// High-Performance Search
const {
  performSearch,
  getSpellingSuggestions: getWorkerSpellingSuggestions,
  preloadAndWarmup,
  workerReady,
  cacheReady,
  metrics: performanceMetrics,
  LAUNCH_TIME_TARGET,
  SEARCH_TIME_TARGET
} = useHighPerformanceSearch()

// AI Integration
const { sendMessage, isAvailable: aiAvailable } = useAI()

// Voice Commands Integration
const {
  startListening,
  stopListening,
  isListening,
  isSupported: voiceCommandsSupported,
  transcript,
  confidence
} = useVoiceCommands()

// Debounce timer
let debounceTimer = null

// Enhanced data with intelligence tags and keywords
const allItems = ref([
  // Files
  {
    id: 'file-1',
    type: 'file',
    title: 'workspace.vue',
    description: 'Main workspace component',
    icon: '📄',
    path: 'app/pages/workspace.vue',
    badge: 'Vue',
    category: 'Files',
    tags: ['vue', 'component', 'workspace', 'main', 'page'],
    keywords: ['workspace', 'main', 'component', 'vue', 'page']
  },
  {
    id: 'file-2',
    type: 'file',
    title: 'package.json',
    description: 'Project configuration',
    icon: '📦',
    path: 'package.json',
    badge: 'JSON',
    category: 'Files',
    tags: ['config', 'dependencies', 'npm', 'project', 'json'],
    keywords: ['package', 'config', 'dependencies', 'npm']
  },
  {
    id: 'file-3',
    type: 'file',
    title: 'tailwind.config.js',
    description: 'Tailwind CSS configuration',
    icon: '🎨',
    path: 'tailwind.config.js',
    badge: 'Config',
    category: 'Files',
    tags: ['tailwind', 'css', 'style', 'config', 'design'],
    keywords: ['tailwind', 'css', 'styles', 'config', 'design']
  },

  // Commands
  {
    id: 'cmd-1',
    type: 'command',
    title: 'New File',
    description: 'Create a new file',
    icon: '📝',
    action: 'create-file',
    category: 'Commands',
    tags: ['new', 'create', 'file', 'add'],
    keywords: ['new', 'create', 'file', 'add', 'make']
  },
  {
    id: 'cmd-2',
    type: 'command',
    title: 'New Folder',
    description: 'Create a new folder',
    icon: '📁',
    action: 'create-folder',
    category: 'Commands',
    tags: ['new', 'create', 'folder', 'directory'],
    keywords: ['new', 'create', 'folder', 'directory', 'mkdir']
  },
  {
    id: 'cmd-3',
    type: 'command',
    title: 'Git Status',
    description: 'Show git status',
    icon: '🔄',
    action: 'git-status',
    category: 'Commands',
    tags: ['git', 'status', 'version', 'control'],
    keywords: ['git', 'status', 'changes', 'repository']
  },
  {
    id: 'cmd-4',
    type: 'command',
    title: 'Terminal',
    description: 'Open terminal',
    icon: '💻',
    action: 'open-terminal',
    category: 'Commands',
    tags: ['terminal', 'console', 'command', 'shell'],
    keywords: ['terminal', 'console', 'shell', 'command', 'cli']
  },

  // AI Actions
  {
    id: 'ai-1',
    type: 'ai',
    title: 'Explain Code',
    description: 'Get AI explanation for selected code',
    icon: '🤖',
    action: 'ai-explain',
    category: 'AI Assistant',
    tags: ['explain', 'understand', 'ai', 'help', 'code'],
    keywords: ['explain', 'ai', 'help', 'understand', 'code']
  },
  {
    id: 'ai-2',
    type: 'ai',
    title: 'Generate Code',
    description: 'Generate code from natural language',
    icon: '🤖',
    action: 'ai-generate',
    category: 'AI Assistant',
    tags: ['generate', 'create', 'ai', 'code', 'write'],
    keywords: ['generate', 'create', 'ai', 'code', 'write']
  },

  // Quick Actions
  {
    id: 'quick-1',
    type: 'quick',
    title: 'Daily Notes',
    description: 'Open today\'s notes',
    icon: '📋',
    action: 'daily-notes',
    category: 'Quick Actions',
    tags: ['daily', 'notes', 'journal', 'today'],
    keywords: ['daily', 'notes', 'journal', 'today', 'writing']
  },
  {
    id: 'quick-2',
    type: 'quick',
    title: 'Task List',
    description: 'View your task list',
    icon: '✅',
    action: 'tasks',
    category: 'Quick Actions',
    tags: ['tasks', 'todo', 'list', 'productivity'],
    keywords: ['tasks', 'todo', 'list', 'productivity', 'work']
  }
])

// Recent items (loaded from localStorage)
const recentItems = ref([])

// Enhanced Computed Properties
const currentIcon = computed(() => {
  if (currentMode.value === 'ai' || detectedIntent.value === 'ai') return AIIcon
  if (currentMode.value === 'commands' || detectedIntent.value === 'command') return CommandIcon
  return SearchIcon
})

const dynamicPlaceholder = computed(() => {
  if (currentMode.value === 'ai') {
    return isProcessingAI.value ? 'AI is thinking...' : 'Ask AI anything...'
  }
  if (currentMode.value === 'commands') return 'Run command...'

  // Intent-based placeholders
  switch (detectedIntent.value) {
    case 'ai': return 'Ask AI anything...'
    case 'command': return 'Run command...'
    case 'file': return 'Search files...'
    case 'navigation': return 'Navigate to...'
    default: return 'Search files, run commands, or ask AI...'
  }
})

const intentIndicatorClass = computed(() => {
  const base = 'transition-all duration-200'
  switch (detectedIntent.value) {
    case 'ai': return `${base} bg-blue-100 text-blue-600`
    case 'command': return `${base} bg-green-100 text-green-600`
    case 'file': return `${base} bg-purple-100 text-purple-600`
    case 'navigation': return `${base} bg-orange-100 text-orange-600`
    default: return `${base} bg-gray-100 text-gray-600`
  }
})

// High-performance search with worker and caching
const filteredResults = ref([])
const isSearchingActive = ref(false)

// Perform search with high-performance system
const performHighPerformanceSearch = async () => {
  if (!debouncedQuery.value.trim()) {
    filteredResults.value = []
    searchTime.value = 0
    return
  }

  isSearchingActive.value = true

  try {
    const context = 'pro-command-center'
    const userPrefs = await getUserPreferences?.() || {}

    const result = await performSearch(
      debouncedQuery.value,
      allItems.value,
      {
        context,
        maxResults: 15,
        mode: 'comprehensive',
        userPreferences: userPrefs,
        useCache: true
      }
    )

    filteredResults.value = result.results || []
    searchTime.value = result.searchTime || 0

    // Log performance for monitoring
    if (result.searchTime > SEARCH_TIME_TARGET) {
      console.warn(`Search exceeded target: ${result.searchTime}ms > ${SEARCH_TIME_TARGET}ms`)
    }
  } catch (error) {
    console.error('High-performance search failed:', error)
    // Fallback to basic search
    filteredResults.value = basicFallbackSearch(debouncedQuery.value)
  } finally {
    isSearchingActive.value = false
  }
}

// Basic fallback search for error cases
const basicFallbackSearch = (query) => {
  const queryLower = query.toLowerCase()
  return allItems.value
    .filter(item =>
      item.title?.toLowerCase().includes(queryLower)
      || item.description?.toLowerCase().includes(queryLower)
    )
    .slice(0, 10)
}

// High-performance spelling suggestions
const spellingSuggestions = ref([])

const updateSpellingSuggestions = async () => {
  if (debouncedQuery.value && filteredResults.value.length === 0) {
    try {
      spellingSuggestions.value = await getWorkerSpellingSuggestions(
        debouncedQuery.value,
        allItems.value,
        3
      )
    } catch (error) {
      console.warn('Spelling suggestions failed:', error)
      spellingSuggestions.value = []
    }
  } else {
    spellingSuggestions.value = []
  }
}

// Intelligence stats for footer
// Removed unused intelligenceStats computed property

// Enhanced Methods
const open = () => {
  isOpen.value = true
  selectedIndex.value = 0

  // Refresh dashboard data for instant display
  refreshDashboardData()

  // Load predictive suggestions (legacy support)
  loadPredictiveSuggestions()

  // Check if we should show mode toggle
  showModeToggle.value = aiAvailable || voiceSupported.value

  nextTick(() => {
    inputRef.value?.focus()
  })

  loadRecentItems()
}

// Mode Switching
const switchMode = (mode) => {
  currentMode.value = mode
  query.value = ''
  selectedIndex.value = 0

  // Clear AI conversation when switching away from AI mode
  if (mode !== 'ai') {
    aiConversation.value = []
  }

  // Focus input
  nextTick(() => {
    inputRef.value?.focus()
  })
}

// Enhanced Multi-Intent Detection System (used internally)
const _detectIntent = (inputText) => {
  const text = inputText.toLowerCase().trim()

  // AI intent patterns (enhanced)
  if (text.startsWith('ai:') || text.includes('help me') || text.includes('how to')
    || text.includes('what is') || text.includes('explain') || text.includes('?')
    || text.includes('generate') || text.includes('create code') || text.includes('debug')
    || text.includes('optimize') || text.includes('refactor') || text.includes('suggest')) {
    return 'ai'
  }

  // Command intent patterns (enhanced)
  if (text.startsWith('>') || text.startsWith('!') || text.includes('run')
    || text.includes('execute') || text.includes('command') || text.includes('terminal')
    || text.includes('build') || text.includes('deploy') || text.includes('install')
    || text.includes('npm') || text.includes('git') || text.includes('pnpm')) {
    return 'command'
  }

  // File intent patterns (enhanced)
  if (text.includes('.') && (text.includes('vue') || text.includes('js')
    || text.includes('ts') || text.includes('css') || text.includes('json')
    || text.includes('md') || text.includes('html') || text.includes('py')
    || text.includes('config') || text.includes('env'))) {
    return 'file'
  }

  // Navigation intent patterns (enhanced)
  if (text.includes('go to') || text.includes('navigate') || text.includes('open')
    || text.includes('switch to') || text.includes('show') || text.includes('view')
    || text.includes('dashboard') || text.includes('settings') || text.includes('workspace')) {
    return 'navigation'
  }

  return 'search'
}

// Advanced Multi-Intent Recognition
const detectMultipleIntents = (inputText) => {
  const text = inputText.toLowerCase().trim()
  const intents = []
  const confidence = {}

  // Define intent patterns with confidence weights
  const patterns = {
    ai: {
      patterns: ['ai:', 'help me', 'how to', 'what is', 'explain', '?', 'generate', 'create code', 'debug', 'optimize', 'refactor', 'suggest'],
      weight: 1.0
    },
    command: {
      patterns: ['>', '!', 'run', 'execute', 'command', 'terminal', 'build', 'deploy', 'install', 'npm', 'git', 'pnpm'],
      weight: 0.9
    },
    file: {
      patterns: ['.vue', '.js', '.ts', '.css', '.json', '.md', '.html', '.py', 'config', '.env'],
      weight: 0.8
    },
    navigation: {
      patterns: ['go to', 'navigate', 'open', 'switch to', 'show', 'view', 'dashboard', 'settings', 'workspace'],
      weight: 0.7
    },
    search: {
      patterns: ['find', 'search', 'look for', 'locate'],
      weight: 0.6
    }
  }

  // Calculate confidence for each intent
  Object.entries(patterns).forEach(([intent, { patterns: intentPatterns, weight }]) => {
    let score = 0
    let matchCount = 0

    intentPatterns.forEach((pattern) => {
      if (text.includes(pattern)) {
        matchCount++
        score += weight * (pattern.length / text.length) // Longer matches get higher scores
      }
    })

    if (score > 0) {
      confidence[intent] = Math.min(score * (matchCount / intentPatterns.length), 1.0)
      intents.push({ intent, confidence: confidence[intent] })
    }
  })

  // Sort by confidence and return top intents
  intents.sort((a, b) => b.confidence - a.confidence)

  // If no specific intent detected, default to search
  if (intents.length === 0) {
    intents.push({ intent: 'search', confidence: 0.5 })
    confidence.search = 0.5
  }

  return { intents: intents.slice(0, 3), confidence } // Return top 3 intents
}

// Progressive Learning System
const learnFromUserInteraction = (query, selectedResult, executionSuccess) => {
  const timestamp = Date.now()
  const interaction = {
    query,
    selectedResult,
    executionSuccess,
    timestamp,
    detectedIntent: detectedIntent.value,
    confidence: intentConfidence.value
  }

  // Store interaction
  learningData.value.commandHistory.push(interaction)

  // Update search patterns
  if (!learningData.value.searchPatterns[query]) {
    learningData.value.searchPatterns[query] = {
      count: 0,
      successRate: 0,
      averageTime: 0,
      preferredResults: []
    }
  }

  const pattern = learningData.value.searchPatterns[query]
  pattern.count++
  pattern.successRate = (pattern.successRate + (executionSuccess ? 1 : 0)) / 2

  // Update user preferences
  if (selectedResult) {
    if (!learningData.value.userPreferences[selectedResult.type]) {
      learningData.value.userPreferences[selectedResult.type] = 0
    }
    learningData.value.userPreferences[selectedResult.type]++
  }

  // Calculate intent accuracy
  const recentInteractions = learningData.value.commandHistory.slice(-50)
  const accurateIntents = recentInteractions.filter(i =>
    i.executionSuccess && i.confidence[i.detectedIntent] > 0.7
  ).length
  learningData.value.intentAccuracy = accurateIntents / recentInteractions.length

  // Save to localStorage
  localStorage.setItem('proCommandCenter_learningData', JSON.stringify(learningData.value))
}

// Contextual Intelligence
const generateContextualSuggestions = (currentQuery) => {
  const suggestions = []
  const timeOfDay = new Date().getHours()

  // Time-based contextual suggestions
  if (timeOfDay >= 9 && timeOfDay <= 12) {
    suggestions.push({
      id: 'morning-standup',
      title: 'Daily Standup Notes',
      description: 'Create standup meeting notes',
      icon: '🌅',
      type: 'template',
      confidence: 0.8
    })
  }

  if (timeOfDay >= 14 && timeOfDay <= 17) {
    suggestions.push({
      id: 'afternoon-review',
      title: 'Code Review Session',
      description: 'Review pending pull requests',
      icon: '🔍',
      type: 'action',
      confidence: 0.7
    })
  }

  // Pattern-based suggestions
  const queryLower = currentQuery.toLowerCase()
  if (queryLower.includes('bug') || queryLower.includes('error')) {
    suggestions.push({
      id: 'debug-assistant',
      title: 'Debug Assistant',
      description: 'AI-powered debugging help',
      icon: '🐛',
      type: 'ai',
      confidence: 0.9
    })
  }

  if (queryLower.includes('deploy') || queryLower.includes('build')) {
    suggestions.push({
      id: 'deployment-checklist',
      title: 'Deployment Checklist',
      description: 'Pre-deployment verification',
      icon: '🚀',
      type: 'template',
      confidence: 0.85
    })
  }

  return suggestions.filter(s => s.confidence > 0.6).slice(0, 5)
}

// Zero-State Dashboard Intelligence
const calculateActivityScore = (item) => {
  const now = Date.now()
  const timeDiff = now - (item.timestamp || item.lastAccessed || now)
  const hoursAgo = timeDiff / (1000 * 60 * 60)

  // Recency weight (decay over time)
  const recencyWeight = 0.4
  const recencyScore = Math.exp(-hoursAgo / 24) // Exponential decay over 24 hours

  // Frequency weight
  const frequencyWeight = 0.3
  const frequencyScore = Math.min((item.accessCount || 1) / 10, 1) // Normalized to 0-1

  // Collaboration weight
  const collaborationWeight = 0.2
  const collaborationScore = (item.collaborators?.length || 0) / 5 // Up to 5 collaborators = max score

  // Context weight (current project relevance)
  const contextWeight = 0.1
  const contextScore = item.isCurrentProject ? 1 : 0.5

  return (
    recencyWeight * recencyScore
    + frequencyWeight * frequencyScore
    + collaborationWeight * collaborationScore
    + contextWeight * contextScore
  )
}

const getTemporalContext = () => {
  const now = new Date()
  const hour = now.getHours()
  const day = now.getDay() // 0 = Sunday, 1 = Monday, etc.
  const month = now.getMonth()

  let timeOfDay = 'morning'
  if (hour >= 12 && hour < 17) timeOfDay = 'afternoon'
  else if (hour >= 17 && hour < 21) timeOfDay = 'evening'
  else if (hour >= 21 || hour < 6) timeOfDay = 'night'

  const dayOfWeek = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][day]
  const workingHours = hour >= 8 && hour <= 18 && day >= 1 && day <= 5

  let seasonalContext = 'spring'
  if (month >= 5 && month <= 7) seasonalContext = 'summer'
  else if (month >= 8 && month <= 10) seasonalContext = 'fall'
  else if (month >= 11 || month <= 1) seasonalContext = 'winter'

  return { timeOfDay, dayOfWeek, workingHours, seasonalContext }
}

const generateQuickActions = () => {
  const temporal = getTemporalContext()
  const actions = []

  // Time-based quick actions
  if (temporal.timeOfDay === 'morning' && temporal.workingHours) {
    actions.push(
      {
        id: 'daily-standup',
        title: 'Create Daily Standup',
        description: 'Quick standup notes template',
        icon: '🌅',
        action: 'create-template',
        template: 'standup',
        priority: 0.9,
        confidence: 0.85
      },
      {
        id: 'review-calendar',
        title: 'Review Today\'s Schedule',
        description: 'Check upcoming meetings and tasks',
        icon: '📅',
        action: 'open-calendar',
        priority: 0.8,
        confidence: 0.8
      }
    )
  }

  if (temporal.timeOfDay === 'afternoon' && temporal.workingHours) {
    actions.push(
      {
        id: 'team-check-in',
        title: 'Team Check-in',
        description: 'Connect with team members',
        icon: '👥',
        action: 'open-chat',
        priority: 0.7,
        confidence: 0.75
      },
      {
        id: 'progress-update',
        title: 'Update Project Status',
        description: 'Share progress with stakeholders',
        icon: '📊',
        action: 'create-update',
        priority: 0.8,
        confidence: 0.8
      }
    )
  }

  if (temporal.dayOfWeek === 'Monday') {
    actions.push({
      id: 'week-planning',
      title: 'Plan This Week',
      description: 'Set weekly goals and priorities',
      icon: '🎯',
      action: 'create-template',
      template: 'weekly-plan',
      priority: 0.9,
      confidence: 0.9
    })
  }

  if (temporal.dayOfWeek === 'Friday' && temporal.timeOfDay === 'afternoon') {
    actions.push({
      id: 'week-review',
      title: 'Weekly Review',
      description: 'Reflect on accomplishments and learnings',
      icon: '📝',
      action: 'create-template',
      template: 'weekly-review',
      priority: 0.85,
      confidence: 0.8
    })
  }

  // Add learning-based actions
  const frequentActions = learningData.value.commandHistory
    .filter(h => h.executionSuccess && h.timestamp > Date.now() - 7 * 24 * 60 * 60 * 1000) // Last 7 days
    .reduce((acc, h) => {
      const key = h.selectedResult?.action || h.selectedResult?.type
      if (key) {
        acc[key] = (acc[key] || 0) + 1
      }
      return acc
    }, {})

  const topActions = Object.entries(frequentActions)
    .sort(([,a], [,b]) => b - a)
    .slice(0, 2)
    .map(([action, count]) => ({
      id: `frequent-${action}`,
      title: `${action.charAt(0).toUpperCase() + action.slice(1).replace('-', ' ')}`,
      description: `Used ${count} times this week`,
      icon: '⚡',
      action,
      priority: 0.6,
      confidence: 0.7
    }))

  actions.push(...topActions)

  return actions
    .sort((a, b) => (b.priority * b.confidence) - (a.priority * a.confidence))
    .slice(0, 5)
}

const generateSmartRecentActivity = () => {
  // Enhanced recent items with smart scoring
  const recentWithScores = recentItems.value
    .map(item => ({
      ...item,
      score: calculateActivityScore(item),
      isRelevant: true,
      contextualNote: generateContextualNote(item)
    }))
    .sort((a, b) => b.score - a.score)
    .slice(0, 7)

  return recentWithScores
}

const generateContextualNote = (item) => {
  const now = Date.now()
  const timeDiff = now - (item.timestamp || item.lastAccessed || now)
  const hoursAgo = Math.floor(timeDiff / (1000 * 60 * 60))
  const daysAgo = Math.floor(hoursAgo / 24)

  if (item.collaborators?.length > 0) {
    return `${item.collaborators.length} team member${item.collaborators.length > 1 ? 's' : ''} active`
  }

  if (daysAgo === 0 && hoursAgo < 2) {
    return 'Recently active'
  }

  if (daysAgo === 0) {
    return `${hoursAgo}h ago`
  }

  if (daysAgo === 1) {
    return 'Yesterday'
  }

  return `${daysAgo} days ago`
}

const generateAdvancedSuggestions = () => {
  const suggestions = []

  // Learning-based suggestions
  const patterns = learningData.value.searchPatterns
  const popularQueries = Object.entries(patterns)
    .filter(([_query, data]) => data.successRate > 0.7 && data.count > 2)
    .sort(([,a], [,b]) => b.count - a.count)
    .slice(0, 3)

  popularQueries.forEach(([query, data]) => {
    suggestions.push({
      id: `popular-${query.replace(/\s+/g, '-')}`,
      title: `Try: "${query}"`,
      description: `${Math.round(data.successRate * 100)}% success rate`,
      icon: '🔍',
      action: 'search',
      query,
      confidence: data.successRate
    })
  })

  // Feature discovery suggestions
  const underusedFeatures = [
    {
      id: 'voice-commands',
      title: 'Try Voice Commands',
      description: 'Use voice to navigate faster',
      icon: '🎤',
      action: 'enable-voice',
      confidence: 0.6
    },
    {
      id: 'ai-assistant',
      title: 'Ask AI Assistant',
      description: 'Get help with complex tasks',
      icon: '🤖',
      action: 'switch-mode',
      mode: 'ai',
      confidence: 0.7
    }
  ]

  // Add underused features if user hasn't tried them recently
  const recentActions = learningData.value.commandHistory
    .slice(-20)
    .map(h => h.selectedResult?.action)

  underusedFeatures.forEach((feature) => {
    if (!recentActions.includes(feature.action)) {
      suggestions.push(feature)
    }
  })

  return suggestions
    .sort((a, b) => b.confidence - a.confidence)
    .slice(0, 4)
}

const refreshDashboardData = () => {
  const startTime = performance.now()

  dashboardData.value = {
    quickActions: generateQuickActions(),
    recentActivity: generateSmartRecentActivity(),
    contextualSuggestions: generateAdvancedSuggestions(),
    temporalContext: getTemporalContext(),
    lastRefresh: Date.now()
  }

  const refreshTime = performance.now() - startTime
  if (refreshTime > 50) {
    console.warn(`Dashboard refresh took ${Math.round(refreshTime)}ms - consider optimization`)
  }
}

// Dashboard Action Handlers
const executeDashboardAction = (action) => {
  // Learn from this interaction
  learnFromUserInteraction('', action, true)

  // Execute based on action type
  switch (action.action) {
    case 'create-template':
      emit('execute', {
        type: 'template',
        action: 'create',
        template: action.template,
        data: action
      })
      break
    case 'open-calendar':
      emit('execute', {
        type: 'calendar',
        action: 'open',
        data: action
      })
      break
    case 'open-chat':
      emit('execute', {
        type: 'chat',
        action: 'open',
        data: action
      })
      break
    case 'create-update':
      emit('execute', {
        type: 'update',
        action: 'create',
        data: action
      })
      break
    case 'switch-mode':
      if (action.mode) {
        switchMode(action.mode)
        return // Don't close for mode switches
      }
      break
    case 'enable-voice':
      if (voiceSupported.value) {
        toggleVoiceCommand()
        return // Don't close for voice toggle
      }
      break
    default:
      emit('execute', {
        type: action.action,
        action: 'execute',
        data: action
      })
  }

  close()
}

const executeDashboardSuggestion = (suggestion) => {
  // Learn from this interaction
  learnFromUserInteraction('', suggestion, true)

  if (suggestion.action === 'search' && suggestion.query) {
    // Populate search field and trigger search
    query.value = suggestion.query
    handleInput()
    return // Don't close for search suggestions
  }

  if (suggestion.action === 'switch-mode' && suggestion.mode) {
    switchMode(suggestion.mode)
    return // Don't close for mode switches
  }

  // Default action execution
  emit('execute', {
    type: suggestion.action,
    action: 'execute',
    data: suggestion
  })

  close()
}

// Predictive Suggestions
const loadPredictiveSuggestions = () => {
  const timeOfDay = new Date().getHours()
  const dayOfWeek = new Date().getDay()

  // Time-based suggestions
  const suggestions = []

  if (timeOfDay >= 9 && timeOfDay <= 17) {
    suggestions.push({
      id: 'work-focus',
      title: 'Focus Session',
      description: 'Start a focused work session',
      icon: '🎯',
      type: 'action'
    })
  }

  if (timeOfDay >= 17 || timeOfDay <= 9) {
    suggestions.push({
      id: 'daily-review',
      title: 'Daily Review',
      description: 'Review your day and plan tomorrow',
      icon: '📝',
      type: 'action'
    })
  }

  // Day-based suggestions
  if (dayOfWeek === 1) { // Monday
    suggestions.push({
      id: 'week-planning',
      title: 'Week Planning',
      description: 'Plan your week ahead',
      icon: '📅',
      type: 'action'
    })
  }

  // Recent pattern-based suggestions
  if (userPatterns.value.frequentFiles) {
    userPatterns.value.frequentFiles.slice(0, 2).forEach((file) => {
      suggestions.push({
        id: `frequent-${file.id}`,
        title: file.title,
        description: `Frequently accessed • ${file.accessCount} times`,
        icon: file.icon,
        type: 'file'
      })
    })
  }

  predictiveSuggestions.value = suggestions.slice(0, 4)
}

const close = () => {
  isOpen.value = false
  query.value = ''
  selectedIndex.value = 0
  emit('close')
}

const handleBackdropClick = (e) => {
  if (e.target === e.currentTarget) {
    close()
  }
}

const handleInput = () => {
  selectedIndex.value = 0

  // Enhanced Multi-Intent Detection
  const multiIntentResult = detectMultipleIntents(query.value)
  detectedIntents.value = multiIntentResult.intents
  intentConfidence.value = multiIntentResult.confidence
  detectedIntent.value = multiIntentResult.intents[0]?.intent || 'search'

  // Generate contextual suggestions
  if (query.value.trim()) {
    contextualSuggestions.value = generateContextualSuggestions(query.value)
  }

  // Auto-switch to AI mode if AI intent is detected with high confidence
  if (detectedIntent.value === 'ai' && intentConfidence.value.ai > 0.8 && currentMode.value !== 'ai') {
    currentMode.value = 'ai'
    showModeToggle.value = true
  }

  // Auto-switch to command mode if command intent is detected with high confidence
  if (detectedIntent.value === 'command' && intentConfidence.value.command > 0.8 && currentMode.value !== 'commands') {
    currentMode.value = 'commands'
    showModeToggle.value = true
  }

  // Clear previous timer
  if (debounceTimer) {
    clearTimeout(debounceTimer)
  }

  // Show loading immediately for better UX
  if (query.value.trim()) {
    isLoading.value = true
  }

  // Optimized debouncing for high-performance search with multi-intent support
  debounceTimer = setTimeout(async () => {
    debouncedQuery.value = query.value

    // Handle different modes with multi-intent awareness
    if (currentMode.value === 'ai' && query.value.trim()) {
      // Don't auto-trigger AI in AI mode - wait for Enter
      isLoading.value = false
    } else if (query.value.trim()) {
      await performHighPerformanceSearch()
      await updateSpellingSuggestions()

      // Add contextual and multi-intent results
      if (contextualSuggestions.value.length > 0) {
        filteredResults.value = [...contextualSuggestions.value, ...filteredResults.value]
      }

      isLoading.value = false
    } else {
      filteredResults.value = []
      spellingSuggestions.value = []
      contextualSuggestions.value = []
      searchTime.value = 0
      isLoading.value = false
    }
  }, 100) // Reduced debounce for better responsiveness
}

// AI Conversation Methods
const handleAIQuery = async () => {
  if (isProcessingAI.value || !query.value.trim()) return

  isProcessingAI.value = true

  // Add user message to conversation
  const userMessage = {
    id: Date.now(),
    role: 'user',
    content: query.value,
    timestamp: new Date()
  }
  aiConversation.value.push(userMessage)

  try {
    const response = await sendMessage(query.value, {
      context: 'command-center',
      conversationHistory: aiConversation.value.slice(-5) // Last 5 messages for context
    })

    // Add AI response
    const aiMessage = {
      id: Date.now() + 1,
      role: 'assistant',
      content: response.text || 'I apologize, but I encountered an issue processing your request.',
      timestamp: new Date(),
      actions: response.actions || []
    }
    aiConversation.value.push(aiMessage)
  } catch (error) {
    console.error('AI query error:', error)
    aiConversation.value.push({
      id: Date.now() + 1,
      role: 'assistant',
      content: 'I apologize, but I encountered an error. Please try again.',
      timestamp: new Date()
    })
  } finally {
    isProcessingAI.value = false
    query.value = '' // Clear input after sending
  }
}

const formatMessage = (content) => {
  // Simple markdown-like formatting for professional appearance
  return content
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/`(.*?)`/g, '<code class="bg-gray-100 px-1 py-0.5 rounded text-sm">$1</code>')
    .replace(/\n/g, '<br>')
}

const executeAIAction = (action) => {
  emit('execute-action', { type: 'ai_action', action })
  // Learn from AI action usage
  learnFromAction(action, query.value, 'ai-conversation')
}

const executePredictiveSuggestion = (suggestion) => {
  emit('execute-action', { type: 'predictive', suggestion })
  // Learn from predictive suggestion usage
  learnFromAction(suggestion, '', 'predictive-suggestion')
  close()
}

// Voice Command Methods
const toggleVoiceCommand = () => {
  if (isVoiceListening.value) {
    stopVoiceListening()
  } else {
    startVoiceListening()
  }
}

const startVoiceListening = async () => {
  try {
    await startListening()
    isVoiceListening.value = true
  } catch (error) {
    console.warn('Voice listening failed:', error)
  }
}

const stopVoiceListening = () => {
  stopListening()
  isVoiceListening.value = false
}

// Watch voice transcript and apply to query
watch(transcript, (newTranscript) => {
  if (newTranscript && confidence.value > 0.7) {
    query.value = newTranscript
    handleInput()
  }
})

const handleKeyDown = (e) => {
  if (e.key === 'Escape') {
    e.preventDefault()
    close()
  }
}

const handleInputKeyDown = (e) => {
  // Enhanced keyboard handling with mode support
  switch (e.key) {
    case 'Enter':
      e.preventDefault()
      if (currentMode.value === 'ai') {
        // Handle AI query
        if (query.value.trim()) {
          handleAIQuery()
        }
      } else {
        // Handle regular search results
        const results = query.value ? filteredResults.value : recentItems.value.slice(0, 5)
        if (results[selectedIndex.value]) {
          executeItem(results[selectedIndex.value])
        }
      }
      break

    case 'ArrowDown':
      e.preventDefault()
      if (currentMode.value !== 'ai') {
        const results = query.value ? filteredResults.value : recentItems.value.slice(0, 5)
        selectedIndex.value = Math.min(selectedIndex.value + 1, results.length - 1)
      }
      break

    case 'ArrowUp':
      e.preventDefault()
      if (currentMode.value !== 'ai') {
        selectedIndex.value = Math.max(selectedIndex.value - 1, 0)
      }
      break

    case 'Tab':
      e.preventDefault()
      if (e.shiftKey) {
        // Shift+Tab: Previous mode
        const currentIndex = modes.value.findIndex(m => m.key === currentMode.value)
        const prevIndex = currentIndex > 0 ? currentIndex - 1 : modes.value.length - 1
        switchMode(modes.value[prevIndex].key)
      } else {
        // Tab: Next mode or auto-complete
        if (showModeToggle.value) {
          const currentIndex = modes.value.findIndex(m => m.key === currentMode.value)
          const nextIndex = currentIndex < modes.value.length - 1 ? currentIndex + 1 : 0
          switchMode(modes.value[nextIndex].key)
        } else {
          // Auto-complete for files
          const results = query.value ? filteredResults.value : recentItems.value.slice(0, 5)
          if (results[selectedIndex.value] && results[selectedIndex.value].type === 'file') {
            query.value = results[selectedIndex.value].title
          }
        }
      }
      break

    case 'Escape':
      e.preventDefault()
      if (currentMode.value === 'ai' && aiConversation.value.length > 0) {
        // Clear AI conversation first
        aiConversation.value = []
        query.value = ''
      } else {
        // Close command center
        close()
      }
      break
  }
}

const executeItem = (item) => {
  let executionSuccess = true

  try {
    // Learn from this action for intelligence (legacy)
    const context = 'pro-command-center'
    learnFromAction(item, query.value, context)

    // Progressive Learning - Track user interaction
    learnFromUserInteraction(query.value, item, executionSuccess)

    // Monitor search performance if this was from a search
    if (searchTime.value > 0) {
      const { $performanceMonitor } = useNuxtApp()
      if ($performanceMonitor) {
        $performanceMonitor.monitorSearchPerformance(
          query.value,
          searchTime.value,
          filteredResults.value.length,
          false // Not a cache hit in this flow
        )
      }
    }

    // Add to recent items (legacy support)
    addToRecent(item)

    // Execute the item
    emit('execute', {
      type: item.type,
      action: item.action,
      data: item,
      intent: detectedIntent.value,
      confidence: intentConfidence.value,
      multiIntents: detectedIntents.value
    })

    // Close the command center
    close()
  } catch (error) {
    executionSuccess = false
    console.error('Error executing item:', error)

    // Learn from failed execution
    learnFromUserInteraction(query.value, item, executionSuccess)

    // Still close the command center but could show error toast in the future
    close()
  }
}

const addToRecent = (item) => {
  if (typeof window === 'undefined') return

  const recent = recentItems.value.filter(r => r.id !== item.id)
  recent.unshift({
    ...item,
    timestamp: Date.now()
  })

  recentItems.value = recent.slice(0, 10)

  try {
    localStorage.setItem('command-center-recent', JSON.stringify(recentItems.value))
  } catch (error) {
    console.warn('Failed to save recent items:', error)
  }
}

const loadRecentItems = () => {
  if (typeof window === 'undefined') return

  try {
    const stored = localStorage.getItem('command-center-recent')
    if (stored) {
      recentItems.value = JSON.parse(stored)
    }
  } catch (error) {
    console.warn('Failed to load recent items:', error)
  }
}

const highlightMatch = (text, searchTerm) => {
  if (!searchTerm.trim()) return text

  const cleanTerm = searchTerm.replace(/^(ai:|>)/, '').trim()
  if (!cleanTerm) return text

  const regex = new RegExp(`(${cleanTerm})`, 'gi')
  return text.replace(regex, '<mark class="bg-yellow-200 text-yellow-900 px-0.5 rounded">$1</mark>')
}

// Global keyboard handler
const handleGlobalKeyDown = (e) => {
  // Ctrl+K or Cmd+K
  if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
    e.preventDefault()
    if (isOpen.value) {
      close()
    } else {
      open()
    }
  }

  // Ctrl+Shift+P or Cmd+Shift+P (alternative)
  if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === 'P') {
    e.preventDefault()
    if (isOpen.value) {
      close()
    } else {
      open()
    }
  }
}

// Enhanced Lifecycle with all feature initialization
onMounted(async () => {
  const startTime = performance.now()

  document.addEventListener('keydown', handleGlobalKeyDown)

  // Initialize voice support detection
  voiceSupported.value = voiceCommandsSupported

  // Load settings
  loadSettings()

  // Load user patterns for predictive features
  try {
    const stored = localStorage.getItem('command-center-patterns')
    if (stored) {
      userPatterns.value = JSON.parse(stored)
    }
  } catch (error) {
    console.warn('Failed to load user patterns:', error)
  }

  // Initialize Progressive Learning System
  try {
    const storedLearningData = localStorage.getItem('proCommandCenter_learningData')
    if (storedLearningData) {
      learningData.value = { ...learningData.value, ...JSON.parse(storedLearningData) }
    }
  } catch (error) {
    console.warn('Failed to load learning data:', error)
  }

  // Load data in parallel for faster initialization
  await Promise.all([
    loadRecentItems(),
    loadPreferences(),
    loadPredictiveSuggestions(),
    // Preload and warmup the high-performance search
    preloadAndWarmup(allItems.value)
  ])

  // Initialize dashboard data after basic loading
  refreshDashboardData()

  const initTime = performance.now() - startTime

  // Monitor launch performance
  const { $performanceMonitor } = useNuxtApp()
  if ($performanceMonitor) {
    $performanceMonitor.monitorLaunchPerformance('ProCommandCenter', startTime)
  }

  // Check if we met the launch time target
  if (initTime <= LAUNCH_TIME_TARGET) {
    console.log(`✅ Enhanced ProCommandCenter initialized in ${initTime}ms (target: ${LAUNCH_TIME_TARGET}ms)`)
  } else {
    console.warn(`⚠️ Enhanced ProCommandCenter initialization exceeded target: ${initTime}ms > ${LAUNCH_TIME_TARGET}ms`)
  }
})

onUnmounted(() => {
  document.removeEventListener('keydown', handleGlobalKeyDown)
  savePreferences()

  // Save user patterns for predictive features
  try {
    localStorage.setItem('command-center-patterns', JSON.stringify(userPatterns.value))
  } catch (error) {
    console.warn('Failed to save user patterns:', error)
  }

  // Cleanup voice commands
  if (isVoiceListening.value) {
    stopVoiceListening()
  }

  // Cleanup timers
  if (debounceTimer) {
    clearTimeout(debounceTimer)
  }
})

// Enhanced Watchers
watch(query, () => {
  selectedIndex.value = 0
})

// Watch for mode changes to update UI
watch(currentMode, (_newMode) => {
  // Reset selection when switching modes
  selectedIndex.value = 0

  // Update placeholder immediately
  nextTick(() => {
    inputRef.value?.focus()
  })
})

// Watch for voice listening state
watch(isListening, (listening) => {
  isVoiceListening.value = listening
})

// Settings Methods
const toggleSettings = () => {
  showSettings.value = !showSettings.value
  if (showSettings.value) {
    // Copy current settings to temp when opening
    tempSettings.value = { ...settings.value }
    settingsChanged.value = false
  }
}

const toggleSection = (section) => {
  expandedSections.value[section] = !expandedSections.value[section]
}

const markSettingsChanged = () => {
  settingsChanged.value = true
}

const toggleTempSetting = (key) => {
  tempSettings.value[key] = !tempSettings.value[key]
  markSettingsChanged()
}

const saveSettings = () => {
  // Copy temp settings to actual settings
  settings.value = { ...tempSettings.value }
  localStorage.setItem('pro-command-center-settings', JSON.stringify(settings.value))
  
  // Apply settings immediately
  applyTheme(settings.value.theme)
  
  settingsChanged.value = false
}

const resetSettings = () => {
  const defaultSettings = {
    theme: 'light',
    aiProvider: 'openai',
    searchSuggestions: true,
    voiceCommands: true,
    analytics: true,
    openaiApiKey: '',
    claudeApiKey: '',
    geminiApiKey: '',
    ollamaBaseUrl: 'http://localhost:11434',
    ollamaModel: 'llama2'
  }
  
  settings.value = { ...defaultSettings }
  tempSettings.value = { ...defaultSettings }
  localStorage.removeItem('pro-command-center-settings')
  connectionStatus.value = null
  settingsChanged.value = false
}

const applyTheme = (theme) => {
  if (theme === 'auto') {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
    document.documentElement.classList.toggle('dark', prefersDark)
  } else {
    document.documentElement.classList.toggle('dark', theme === 'dark')
  }
}

const loadSettings = () => {
  try {
    const saved = localStorage.getItem('pro-command-center-settings')
    if (saved) {
      const parsed = JSON.parse(saved)
      settings.value = { ...settings.value, ...parsed }
      tempSettings.value = { ...settings.value }
      applyTheme(settings.value.theme)
    }
  } catch (error) {
    console.warn('Failed to load settings:', error)
  }
}

const toggleApiKeyVisibility = (provider) => {
  showApiKeys.value[provider] = !showApiKeys.value[provider]
}

const testConnection = async () => {
  connectionStatus.value = { success: false, message: 'Testing connection...' }
  
  try {
    const provider = tempSettings.value.aiProvider
    let testSuccessful = false
    
    switch (provider) {
      case 'openai':
        if (!tempSettings.value.openaiApiKey) {
          throw new Error('OpenAI API key is required')
        }
        // Test OpenAI connection
        testSuccessful = await testOpenAIConnection()
        break
        
      case 'claude':
        if (!tempSettings.value.claudeApiKey) {
          throw new Error('Claude API key is required')
        }
        // Test Claude connection
        testSuccessful = await testClaudeConnection()
        break
        
      case 'gemini':
        if (!tempSettings.value.geminiApiKey) {
          throw new Error('Gemini API key is required')
        }
        // Test Gemini connection
        testSuccessful = await testGeminiConnection()
        break
        
      case 'ollama':
      case 'ollama-turbo':
        if (!tempSettings.value.ollamaBaseUrl) {
          throw new Error('Ollama base URL is required')
        }
        // Test Ollama connection
        testSuccessful = await testOllamaConnection()
        break
        
      default:
        throw new Error('Unknown provider')
    }
    
    if (testSuccessful) {
      connectionStatus.value = { 
        success: true, 
        message: `${provider.charAt(0).toUpperCase() + provider.slice(1)} connection successful!` 
      }
    }
  } catch (error) {
    connectionStatus.value = { 
      success: false, 
      message: `Connection failed: ${error.message}` 
    }
  }
  
  // Clear status after 5 seconds
  setTimeout(() => {
    connectionStatus.value = null
  }, 5000)
}

const testOpenAIConnection = async () => {
  const response = await fetch('https://api.openai.com/v1/models', {
    headers: {
      'Authorization': `Bearer ${tempSettings.value.openaiApiKey}`
    }
  })
  return response.ok
}

const testClaudeConnection = async () => {
  const response = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-api-key': tempSettings.value.claudeApiKey,
      'anthropic-version': '2023-06-01'
    },
    body: JSON.stringify({
      model: 'claude-3-haiku-20240307',
      max_tokens: 1,
      messages: [{ role: 'user', content: 'test' }]
    })
  })
  return response.ok || response.status === 400 // 400 is OK, means auth worked
}

const testGeminiConnection = async () => {
  const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models?key=${tempSettings.value.geminiApiKey}`)
  return response.ok
}

const testOllamaConnection = async () => {
  const response = await fetch(`${tempSettings.value.ollamaBaseUrl}/api/tags`)
  return response.ok
}

// Expose methods
defineExpose({
  open,
  close
})
</script>

<style scoped>
/* Smooth transitions */
.transition-all {
  transition-property: all;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
}

/* Custom scrollbar */
.overflow-y-auto::-webkit-scrollbar {
  width: 4px;
}

.overflow-y-auto::-webkit-scrollbar-track {
  background: transparent;
}

.overflow-y-auto::-webkit-scrollbar-thumb {
  background: rgba(156, 163, 175, 0.5);
  border-radius: 2px;
}

.overflow-y-auto::-webkit-scrollbar-thumb:hover {
  background: rgba(156, 163, 175, 0.8);
}

/* Hidden scrollbar for main content area */
.scrollbar-hide {
  -ms-overflow-style: none;  /* Internet Explorer 10+ */
  scrollbar-width: none;  /* Firefox */
}

.scrollbar-hide::-webkit-scrollbar {
  display: none;  /* Safari and Chrome */
}

/* Backdrop blur */
.backdrop-blur-sm {
  backdrop-filter: blur(4px);
}

.backdrop-blur-xl {
  backdrop-filter: blur(16px);
}

/* Focus styles */
input:focus {
  outline: none;
}

/* Mark highlighting */
:deep(mark) {
  background-color: rgb(254 240 138);
  color: rgb(133 77 14);
  padding: 1px 2px;
  border-radius: 2px;
}

/* Animation improvements */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.15s ease-out;
}
</style>
