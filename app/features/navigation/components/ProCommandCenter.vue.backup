<!--
  Professional Command Center - Production Ready Enhanced

  Features:
  - Instant search with 0ms perceived latency
  - Professional keyboard navigation
  - Smooth animations and micro-interactions
  - Advanced AI conversation interface
  - Intelligent intent detection system
  - Predictive suggestions and learning
  - Voice command integration
  - Multi-mode interface (Search/AI/Commands)
  - Context-aware recommendations
  - Production-grade performance
  - Accessible design
-->

<template>
  <teleport to="body">
    <transition
      enter-active-class="transition-all duration-200 ease-out"
      enter-from-class="opacity-0 scale-95"
      enter-to-class="opacity-100 scale-100"
      leave-active-class="transition-all duration-150 ease-in"
      leave-from-class="opacity-100 scale-100"
      leave-to-class="opacity-0 scale-95"
    >
      <div
        v-if="isOpen"
        class="fixed inset-0 z-[9999] flex items-start justify-center pt-[10vh]"
        @click="handleBackdropClick"
        @keydown="handleKeyDown"
      >
        <!-- Professional backdrop -->
        <div class="absolute inset-0 bg-black/20 backdrop-blur-sm" />

        <!-- Command Center -->
        <div
          ref="panelRef"
          class="relative w-full max-w-2xl h-[80vh] max-h-[600px] mx-4 bg-white/95 backdrop-blur-xl rounded-xl shadow-2xl border border-gray-200/50 overflow-hidden flex flex-col"
          @click.stop
        >
          <!-- Enhanced Header with Mode Switching -->
          <div class="relative">
            <!-- Mode Toggle (Professional Pills) -->
            <div
              v-if="showModeToggle"
              class="flex items-center justify-between px-4 py-2 bg-gray-50/80 border-b border-gray-100/60"
            >
              <div class="flex items-center space-x-1">
                <button
                  v-for="mode in modes"
                  :key="mode.key"
                  :class="[
                    'flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all',
                    currentMode === mode.key
                      ? 'bg-white text-gray-900 shadow-sm border border-gray-200/50'
                      : 'text-gray-600 hover:bg-white/50 hover:text-gray-800'
                  ]"
                  @click="switchMode(mode.key)"
                >
                  <span class="text-xs">{{ mode.icon }}</span>
                  <span>{{ mode.label }}</span>
                </button>
              </div>

              <!-- Voice Control Toggle -->
              <button
                v-if="voiceSupported"
                :class="[
                  'flex items-center space-x-1 px-2 py-1 rounded-lg text-xs transition-colors',
                  isVoiceListening ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                ]"
                @click="toggleVoiceCommand"
              >
                <span>{{ isVoiceListening ? '🔴' : '🎤' }}</span>
                <span>{{ isVoiceListening ? 'Listening...' : 'Voice' }}</span>
              </button>
            </div>

            <!-- Enhanced Input with Intent Detection -->
            <div class="flex items-center px-4 py-3 border-b border-gray-100/80">
              <!-- Intelligent Icon with Intent Indicator -->
              <div class="flex items-center justify-center w-6 h-6 mr-3 flex-shrink-0">
                <div
                  v-if="isLoading || isProcessingAI"
                  class="w-4 h-4 border-2 border-gray-300 border-t-blue-500 rounded-full animate-spin"
                />
                <div
                  v-else
                  :class="[
                    'w-6 h-6 rounded-lg flex items-center justify-center transition-all',
                    intentIndicatorClass
                  ]"
                >
                  <component
                    :is="currentIcon"
                    class="w-4 h-4 transition-colors"
                  />
                </div>
              </div>

              <!-- Universal Input Field -->
              <input
                ref="inputRef"
                v-model="query"
                type="text"
                :placeholder="dynamicPlaceholder"
                class="flex-1 bg-transparent text-base placeholder-gray-400 border-none outline-none"
                autocomplete="off"
                spellcheck="false"
                @input="handleInput"
                @keydown="handleInputKeyDown"
              >

              <!-- AI Processing Indicator -->
              <div
                v-if="isProcessingAI"
                class="mr-3 flex items-center space-x-1"
              >
                <div class="w-2 h-2 bg-blue-400 rounded-full animate-pulse" />
                <span class="text-xs text-blue-600">AI thinking...</span>
              </div>

              <!-- Multi-Intent Confidence Indicators -->
              <div
                v-if="detectedIntents.length > 1 && query.trim()"
                class="flex items-center space-x-1 mr-2 text-xs"
              >
                <div
                  v-for="intent in detectedIntents.slice(0, 3)"
                  :key="intent.intent"
                  :class="[
                    'px-1.5 py-0.5 rounded-lg border text-xs font-medium transition-all',
                    intent.confidence > 0.8 ? 'bg-green-100 border-green-200 text-green-700'
                    : intent.confidence > 0.6 ? 'bg-blue-100 border-blue-200 text-blue-700'
                      : 'bg-gray-100 border-gray-200 text-gray-600'
                  ]"
                  :title="`${intent.intent} (${Math.round(intent.confidence * 100)}%)`"
                >
                  {{ intent.intent }}
                </div>
              </div>

              <!-- Settings Button -->
              <button
                class="flex items-center justify-center w-8 h-8 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors ml-2"
                @click="toggleSettings"
                title="Settings"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </button>

              <!-- Enhanced Keyboard Hints -->
              <div class="flex items-center space-x-1 ml-3 text-xs text-gray-400">
                <kbd class="px-1.5 py-0.5 bg-gray-100 rounded text-xs">Tab</kbd>
                <span class="text-gray-300">|</span>
                <kbd class="px-1.5 py-0.5 bg-gray-100 rounded text-xs">Esc</kbd>
              </div>
            </div>
          </div>

          <!-- Results Container -->
          <div class="flex-1 overflow-hidden">
            <div class="h-full overflow-y-auto scrollbar-hide">
            <!-- AI Conversation Interface -->
            <div
              v-if="currentMode === 'ai' && aiConversation.length"
              class="p-4 space-y-4"
            >
              <div
                v-for="message in aiConversation"
                :key="message.id"
                :class="[
                  'flex space-x-3',
                  message.role === 'user' ? 'justify-end' : 'justify-start'
                ]"
              >
                <!-- AI Avatar (Professional Style) -->
                <div
                  v-if="message.role === 'assistant'"
                  class="w-7 h-7 bg-gradient-to-br from-blue-100 to-blue-200 rounded-lg flex items-center justify-center shadow-sm"
                >
                  <span class="text-sm">🤖</span>
                </div>

                <!-- Message Content (Professional Design) -->
                <div
                  :class="[
                    'max-w-xs lg:max-w-md px-3 py-2.5 rounded-xl shadow-sm border',
                    message.role === 'user'
                      ? 'bg-blue-600 text-white border-blue-600'
                      : 'bg-white text-gray-900 border-gray-200'
                  ]"
                >
                  <div
                    class="text-sm leading-relaxed"
                    v-html="formatMessage(message.content)"
                  />

                  <!-- AI Action Buttons (Professional Style) -->
                  <div
                    v-if="message.actions && message.actions.length"
                    class="flex flex-wrap gap-2 mt-3"
                  >
                    <button
                      v-for="action in message.actions"
                      :key="action.id"
                      :class="[
                        'px-3 py-1.5 text-xs font-medium rounded-lg border transition-all hover:scale-105',
                        message.role === 'user'
                          ? 'border-white/20 hover:bg-white/10 text-white'
                          : 'border-gray-300 hover:bg-gray-50 text-gray-700 hover:border-gray-400'
                      ]"
                      @click="executeAIAction(action)"
                    >
                      {{ action.label }}
                    </button>
                  </div>
                </div>

                <!-- User Avatar -->
                <div
                  v-if="message.role === 'user'"
                  class="w-7 h-7 bg-gradient-to-br from-gray-100 to-gray-200 rounded-lg flex items-center justify-center shadow-sm"
                >
                  <span class="text-sm">👤</span>
                </div>
              </div>
            </div>

            <!-- Contextual Zero-State Dashboard -->
            <div
              v-else-if="!query && currentMode === 'search'"
              class="py-4"
            >
              <!-- Quick Actions Section -->
              <div
                v-if="dashboardData.quickActions.length > 0"
                class="mb-6"
              >
                <div class="px-4 pb-3 flex items-center justify-between">
                  <h3 class="text-sm font-semibold text-gray-900 flex items-center">
                    <span class="mr-2">⚡</span>
                    Quick Actions
                  </h3>
                  <div class="text-xs text-gray-500">
                    {{ dashboardData.temporalContext.timeOfDay }} • {{ dashboardData.temporalContext.dayOfWeek }}
                  </div>
                </div>
                <div class="grid grid-cols-1 gap-2 px-2">
                  <button
                    v-for="action in dashboardData.quickActions.slice(0, 3)"
                    :key="action.id"
                    class="w-full flex items-center px-3 py-3 rounded-xl text-left transition-all hover:bg-gradient-to-r hover:from-blue-50 hover:to-purple-50 hover:shadow-sm group border border-transparent hover:border-blue-200/50"
                    @click="executeDashboardAction(action)"
                  >
                    <div class="w-10 h-10 mr-3 rounded-xl bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                      <span class="text-lg">{{ action.icon }}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="font-semibold text-sm text-gray-900 truncate">
                        {{ action.title }}
                      </div>
                      <div class="text-xs text-gray-600 truncate">
                        {{ action.description }}
                      </div>
                    </div>
                    <div class="flex items-center space-x-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <div
                        :class="[
                          'w-2 h-2 rounded-full',
                          action.confidence > 0.8 ? 'bg-green-400' : action.confidence > 0.6 ? 'bg-blue-400' : 'bg-gray-400'
                        ]"
                      />
                    </div>
                  </button>
                </div>
              </div>

              <!-- Recent Activity Section -->
              <div
                v-if="dashboardData.recentActivity.length > 0"
                class="mb-6"
              >
                <div class="px-4 pb-3">
                  <h3 class="text-sm font-semibold text-gray-900 flex items-center">
                    <span class="mr-2">📁</span>
                    Recent Activity
                  </h3>
                </div>
                <div class="space-y-1 px-2">
                  <button
                    v-for="(item, index) in dashboardData.recentActivity.slice(0, 5)"
                    :key="item.id"
                    :class="[
                      'w-full flex items-center px-3 py-2.5 rounded-lg text-left transition-all group border border-transparent',
                      index === selectedIndex && !query ? 'bg-blue-50 border-blue-200' : 'hover:bg-gray-50 hover:border-gray-200'
                    ]"
                    @click="executeItem(item)"
                  >
                    <div class="w-8 h-8 mr-3 rounded-lg bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center flex-shrink-0">
                      <span class="text-sm">{{ item.icon }}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="font-medium text-sm text-gray-900 truncate">
                        {{ item.title }}
                      </div>
                      <div class="text-xs text-gray-500 truncate flex items-center space-x-2">
                        <span>{{ item.contextualNote }}</span>
                        <span
                          v-if="item.score > 0.8"
                          class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs bg-green-100 text-green-800"
                        >
                          High Priority
                        </span>
                      </div>
                    </div>
                    <div class="flex items-center space-x-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <span
                        :class="[
                          'text-xs px-2 py-0.5 rounded-full',
                          item.badge === 'Vue' ? 'bg-green-100 text-green-800'
                          : item.badge === 'JSON' ? 'bg-yellow-100 text-yellow-800'
                            : 'bg-gray-100 text-gray-600'
                        ]"
                      >
                        {{ item.badge }}
                      </span>
                    </div>
                  </button>
                </div>
              </div>

              <!-- Contextual Suggestions Section -->
              <div
                v-if="dashboardData.contextualSuggestions.length > 0"
                class="mb-4"
              >
                <div class="px-4 pb-3">
                  <h3 class="text-sm font-semibold text-gray-900 flex items-center">
                    <span class="mr-2">🎯</span>
                    Smart Suggestions
                  </h3>
                </div>
                <div class="space-y-1 px-2">
                  <button
                    v-for="suggestion in dashboardData.contextualSuggestions.slice(0, 3)"
                    :key="suggestion.id"
                    class="w-full flex items-center px-3 py-2 rounded-lg text-left transition-all hover:bg-purple-50 hover:border-purple-200 group border border-transparent"
                    @click="executeDashboardSuggestion(suggestion)"
                  >
                    <div class="w-7 h-7 mr-3 rounded-lg bg-gradient-to-br from-purple-100 to-purple-200 flex items-center justify-center flex-shrink-0">
                      <span class="text-sm">{{ suggestion.icon }}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="font-medium text-sm text-gray-900 truncate">
                        {{ suggestion.title }}
                      </div>
                      <div class="text-xs text-gray-500 truncate">
                        {{ suggestion.description }}
                      </div>
                    </div>
                    <div class="flex items-center space-x-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <span class="text-xs text-purple-600 bg-purple-100 px-2 py-0.5 rounded-full">
                        {{ Math.round(suggestion.confidence * 100) }}%
                      </span>
                    </div>
                  </button>
                </div>
              </div>

              <!-- Empty State Fallback -->
              <div
                v-if="dashboardData.quickActions.length === 0 && dashboardData.recentActivity.length === 0"
                class="py-12 text-center"
              >
                <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-blue-100 to-purple-100 flex items-center justify-center">
                  <component
                    :is="currentIcon"
                    class="w-8 h-8 text-blue-600"
                  />
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  Welcome to Pro Command Center
                </h3>
                <p class="text-sm text-gray-600 max-w-xs mx-auto mb-4">
                  Your intelligent workspace that learns and adapts to your workflow
                </p>
                <div class="text-xs text-gray-500">
                  Start by searching, running commands, or asking AI anything
                </div>
              </div>
            </div>

            <!-- Search Results -->
            <div
              v-else-if="query"
              class="py-2"
            >
              <!-- High-Performance Loading State -->
              <div
                v-if="isLoading || isSearchingActive"
                class="px-6 py-8 text-center"
              >
                <div class="w-6 h-6 mx-auto border-2 border-gray-200 border-t-blue-500 rounded-full animate-spin" />
                <p class="mt-2 text-sm text-gray-500">
                  {{ workerReady ? 'Processing in Web Worker...' : 'Searching...' }}
                </p>
                <div
                  v-if="searchTime > 0"
                  class="mt-1 text-xs text-gray-400"
                >
                  Target: &lt;{{ SEARCH_TIME_TARGET }}ms
                </div>
              </div>

              <!-- Results -->
              <div
                v-else-if="filteredResults.length"
                class="space-y-1 px-2"
              >
                <button
                  v-for="(result, index) in filteredResults"
                  :key="result.id"
                  :class="[
                    'w-full flex items-center px-3 py-3 rounded-lg text-left transition-all group',
                    selectedIndex === index
                      ? 'bg-blue-50 text-blue-700 shadow-sm'
                      : 'hover:bg-gray-50 text-gray-700'
                  ]"
                  @click="executeItem(result)"
                  @mouseenter="selectedIndex = index"
                >
                  <!-- Icon -->
                  <div
                    :class="[
                      'w-10 h-10 mr-3 rounded-lg flex items-center justify-center flex-shrink-0',
                      result.iconBg || 'bg-gray-100'
                    ]"
                  >
                    <span class="text-base">{{ result.icon }}</span>
                  </div>

                  <!-- Enhanced Content with Intelligence Indicators -->
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center space-x-2">
                      <div
                        class="font-medium text-sm truncate"
                        v-html="highlightMatch(result.title, query)"
                      />
                      <span
                        v-if="result.badge"
                        class="px-2 py-0.5 bg-gray-100 text-gray-600 text-xs rounded-full"
                      >
                        {{ result.badge }}
                      </span>
                      <!-- Intelligence badges -->
                      <span
                        v-if="result.predicted"
                        class="px-1.5 py-0.5 bg-blue-100 text-blue-600 text-xs rounded"
                      >
                        Predicted
                      </span>
                      <span
                        v-if="result.frequent"
                        class="px-1.5 py-0.5 bg-green-100 text-green-600 text-xs rounded"
                      >
                        Frequent
                      </span>
                    </div>
                    <div class="text-xs text-gray-500 truncate mt-0.5">
                      {{ result.description }}
                    </div>
                    <div
                      v-if="result.path"
                      class="text-xs text-gray-400 truncate mt-0.5"
                    >
                      {{ result.path }}
                    </div>
                    <!-- Match details -->
                    <div
                      v-if="result.matchType"
                      class="flex items-center space-x-2 mt-1"
                    >
                      <span class="text-xs text-gray-400">{{ result.matchType }} match</span>
                      <span
                        v-if="result.confidence"
                        :class="[
                          'text-xs px-1 py-0.5 rounded',
                          result.confidence > 80 ? 'bg-green-100 text-green-600'
                          : result.confidence > 60 ? 'bg-yellow-100 text-yellow-600'
                            : 'bg-gray-100 text-gray-600'
                        ]"
                      >
                        {{ result.confidence }}%
                      </span>
                    </div>
                  </div>

                  <!-- Action Hint -->
                  <div class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center space-x-1">
                    <kbd class="px-1.5 py-0.5 bg-white border rounded text-xs">↵</kbd>
                  </div>
                </button>
              </div>

              <!-- No Results with Spelling Suggestions -->
              <div
                v-else
                class="px-6 py-8 text-center"
              >
                <div class="w-12 h-12 mx-auto mb-4 bg-gray-100 rounded-full flex items-center justify-center">
                  <SearchIcon class="w-6 h-6 text-gray-400" />
                </div>
                <h3 class="text-sm font-medium text-gray-900 mb-1">
                  No results found
                </h3>
                <p class="text-sm text-gray-500 mb-3">
                  Try a different search term or check spelling
                </p>
                <!-- Spelling Suggestions -->
                <div
                  v-if="spellingSuggestions.length"
                  class="space-y-2"
                >
                  <p class="text-xs text-gray-500">
                    Did you mean:
                  </p>
                  <div class="flex justify-center space-x-2">
                    <button
                      v-for="suggestion in spellingSuggestions"
                      :key="suggestion"
                      class="px-3 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm rounded-lg transition-colors"
                      @click="query = suggestion"
                    >
                      {{ suggestion }}
                    </button>
                  </div>
                </div>
              </div>
            </div>
            </div>
          </div>

          <!-- Performance-Enhanced Footer -->
          <div
            v-if="filteredResults.length > 0 || performanceMetrics.totalSearches > 0"
            class="flex items-center justify-between px-4 py-2 bg-gray-50/80 border-t border-gray-100/80"
          >
            <div class="flex items-center space-x-4 text-xs text-gray-500">
              <span v-if="filteredResults.length">
                {{ filteredResults.length }} result{{ filteredResults.length === 1 ? '' : 's' }}
              </span>
              <span
                v-if="searchTime > 0"
                :class="[
                  searchTime <= SEARCH_TIME_TARGET ? 'text-green-600' : 'text-yellow-600'
                ]"
              >
                {{ Math.round(searchTime) }}ms
                <span
                  v-if="searchTime <= SEARCH_TIME_TARGET"
                  class="text-green-500"
                >✓</span>
                <span
                  v-else
                  class="text-yellow-500"
                >⚠</span>
              </span>
              <!-- Learning System Status -->
              <div
                v-if="learningData.intentAccuracy > 0"
                class="flex items-center space-x-1"
              >
                <div
                  :class="[
                    'w-2 h-2 rounded-full',
                    learningData.intentAccuracy > 0.9 ? 'bg-green-500'
                    : learningData.intentAccuracy > 0.7 ? 'bg-blue-500' : 'bg-yellow-500'
                  ]"
                />
                <span>AI {{ Math.round(learningData.intentAccuracy * 100) }}%</span>
              </div>

              <!-- System Status -->
              <div class="flex items-center space-x-1">
                <div
                  :class="[
                    'w-2 h-2 rounded-full',
                    workerReady && cacheReady ? 'bg-green-500' : 'bg-yellow-500'
                  ]"
                />
                <span>{{ workerReady && cacheReady ? 'Optimized' : 'Initializing' }}</span>
              </div>
            </div>
            <div class="flex items-center space-x-3 text-xs text-gray-500">
              <div class="flex items-center space-x-1">
                <kbd class="px-1 py-0.5 bg-white border rounded">↑↓</kbd>
                <span>navigate</span>
              </div>
              <div class="flex items-center space-x-1">
                <kbd class="px-1 py-0.5 bg-white border rounded">↵</kbd>
                <span>select</span>
              </div>
              <!-- Performance indicator -->
              <div
                v-if="performanceMetrics.averageSearchTime > 0"
                class="text-xs text-gray-400"
              >
                Avg: {{ Math.round(performanceMetrics.averageSearchTime) }}ms
              </div>
            </div>
          </div>

          <!-- Settings Panel -->
          <div 
            v-if="showSettings"
            class="border-t border-gray-100 bg-gray-50/50 flex flex-col max-h-96"
          >
            <div class="flex items-center justify-between p-4 pb-2">
              <h3 class="text-sm font-medium text-gray-900">Settings</h3>
              <button
                v-if="settingsChanged"
                class="px-3 py-1 text-xs bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors"
                @click="saveSettings"
              >
                Save Changes
              </button>
            </div>
            <div class="flex-1 overflow-y-auto scrollbar-hide px-4 pb-4">
              <div class="space-y-3">
              <!-- Theme Setting -->
              <div class="flex items-center justify-between">
                <label class="text-sm text-gray-700">Theme</label>
                <select 
                  v-model="tempSettings.theme"
                  class="text-xs px-2 py-1 border border-gray-200 rounded-lg bg-white"
                  @change="markSettingsChanged"
                >
                  <option value="light">Light</option>
                  <option value="dark">Dark</option>
                  <option value="auto">Auto</option>
                </select>
              </div>

              <!-- AI Configuration Section -->
              <div class="border border-gray-200 rounded-lg bg-white">
                <button
                  class="w-full flex items-center justify-between p-3 text-left hover:bg-gray-50 transition-colors"
                  @click="toggleSection('ai')"
                >
                  <div class="flex items-center space-x-2">
