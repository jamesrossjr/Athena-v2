<script setup>
import { ref, computed, watch, onMounted, onUnmounted, nextTick } from 'vue'
import { useCommandIntelligence } from '../../../composables/useCommandIntelligence'
import { useHighPerformanceSearch } from '../../../composables/useHighPerformanceSearch'
import { useAI } from '../../ai/composables/useAI'
// import { useContextAwareness } from '../../ai/composables/useContextAwareness'
