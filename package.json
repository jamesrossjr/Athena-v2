{
  "name": "canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "mobile:build": "npm run build && npx cap sync",
    "ios:build": "npm run mobile:build && cd ios && fastlane build",
    "android:build": "npm run mobile:build && cd android && fastlane build",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "release:rc": "node scripts/release-rc.js",
    "release:prod": "node scripts/release-prod.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@iconify-json/lucide": "^1.2.62",
    "@iconify-json/simple-icons": "^1.2.48",
    "@nuxt/ui": "^3.3.2",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.56.0",
    "@tweenjs/tween.js": "^25.0.0",
    "@types/three": "^0.179.0",
    "@vueuse/core": "^13.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "fuse.js": "^7.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "node-pty": "^1.0.0",
    "nuxt": "^4.0.3",
    "prism-themes": "^1.9.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.179.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^3.19.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "conventional-changelog-cli": "^4.1.0",
    "eslint": "^9.33.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.6.2",
    "release-it": "^17.11.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  },
  "resolutions": {
    "unimport": "4.1.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  },
  "packageManager": "pnpm@10.13.1"
}
